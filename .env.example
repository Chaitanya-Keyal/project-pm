# Project PM database (created automatically)
PM_DATABASE_URL=sqlite+aiosqlite:///./project-pm.db

# Project Lens config directory (required)
LENS_CONFIG_DIR=/path/to/project-lens-seedsigner-config

# FastAPI
HOST=0.0.0.0
PORT=8420
DEBUG=true

# Admin auth (simple shared secret for admin pages)
ADMIN_TOKEN=change-me-to-something-random
